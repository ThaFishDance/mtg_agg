# Use a dedicated database for this backend. Migrations run only when requested.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/mtg_agg
# Optional: disposable PostgreSQL database for integration tests.
# TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/mtg_agg_test
# Required for authenticated requests: exact Clerk instance issuer and allowed azp origins.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Clerk dashboard PEM public key. Set as a process variable with actual newlines.
# CLERK_JWT_KEY='-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----'
# Optional: require this audience when configured in Clerk session tokens.
# CLERK_AUDIENCE=mtg-api
